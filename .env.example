# Groq (required) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# Tavily research API (optional — research_models degrades gracefully if unset)
TAVILY_API_KEY=

# Hugging Face (optional)
HF_HOME=
HF_HUB_OFFLINE=false

# LangSmith tracing (optional, default disabled)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Uploads / limits
MAX_UPLOAD_MB=20
MAX_ROWS=5000
MAX_PDF_PAGES=200

# Agent
MAX_TOOL_ITERATIONS=6
